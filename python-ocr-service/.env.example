# OCR Service Configuration

# Engine Selection
# Set to "true" to use DeepSeek OCR (requires CUDA GPU)
# Set to "false" to use TrOCR (works on CPU)
USE_DEEPSEEK_OCR=true

# Model Paths
DEEPSEEK_MODEL_PATH=deepseek-ai/DeepSeek-OCR
TROCR_MODEL_NAME=microsoft/trocr-base-printed

# OCR Configuration
OCR_DEFAULT_PROMPT=<image>\n<|grounding|>Convert the document to markdown.
OCR_OUTPUT_DIR=./ocr_outputs

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
VLLM_USE_V1=0

# Performance Tuning (for DeepSeek)
GPU_MEMORY_UTILIZATION=0.8
MAX_MODEL_LEN=4096
MAX_CONCURRENCY=100

# Image Processing (for DeepSeek)
BASE_SIZE=1024
IMAGE_SIZE=640
CROP_MODE=true
MIN_CROPS=2
MAX_CROPS=6

# Logging
LOG_LEVEL=INFO
