# Environment Configuration for AI Service Tier 1

# MongoDB Connection
DATABASE_URL=mongodb://localhost:27017
MAIN_DB_NAME=document_processing

# FastAPI Server
HOST=0.0.0.0
PORT=8000

# Model Configuration
MODELS_DIR=/app/models
LLAMA_MODEL_PATH=/app/models/llama-3.2-3b-gguf/model.gguf

# HuggingFace Token (optional, for private models)
HUGGING_FACE_HUB_TOKEN=

# Logging
LOG_LEVEL=INFO

# PDF Processing
PDF_PAGE_LIMIT=100
OCR_CONFIDENCE_THRESHOLD=0.5

# Document Processing
DOCUMENT_SPLIT_SIMILARITY_THRESHOLD=0.5
CLASSIFICATION_CANDIDATE_LABELS=Invoice,Contract,Receipt,Report,Letter,Form,Agreement,Statement,Certificate,Other

# Performance
MAX_WORKERS=4
BATCH_SIZE=10

# GPU Configuration
USE_GPU=true
CUDA_DEVICE=0
